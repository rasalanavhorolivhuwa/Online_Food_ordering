# Copy to .env.local and adjust. Restart `npm run dev` after changing.

# Features served by the Spring Boot backend; everything else uses in-browser sample data.
# Options: auth, shops, menu, cart, orders, notifications, assistant — or "all".
VITE_LIVE=shops,menu,cart,orders

# Where the dev server forwards /api requests (local Spring Boot or an ngrok URL).
API_PROXY_TARGET=http://localhost:8080

# While auth is still sample data, every login acts as this backend student id.
VITE_DEV_STUDENT_ID=2

# Only needed to call the backend directly instead of through the /api proxy (requires CORS).
# VITE_API_URL=http://localhost:8080

# Demo: move each new order to Preparing, then Ready, every N seconds (0 = off).
VITE_DEMO_STATUS_SECONDS=5
